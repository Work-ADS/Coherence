<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS rewrite rule that lets the Angular router own deep routes.
  Without this, hitting /demos/sarevi-banco-cooperativo directly returns
  the Azure App Service "resource removed" page because no file exists at
  that physical path. Rewriting every non-file, non-directory request to
  /index.html hands routing to the SPA where it belongs.

  apps/site/public/* is copied verbatim into dist via the Angular
  "assets" glob in angular.json, so this file lands at the deploy root.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Angular SPA — rewrite non-files to index.html" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- Modern asset MIME types IIS doesn't ship by default -->
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Thumbnail videos. Without this, IIS returns 401 for *.mp4. -->
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
    </staticContent>

    <!-- Match Angular's "production" cache strategy: hashed assets get
         long-cache, index.html stays uncached so deploys take effect. -->
    <caching>
      <profiles>
        <add extension=".html" policy="DontCache" kernelCachePolicy="DontCache" />
      </profiles>
    </caching>
  </system.webServer>
</configuration>
